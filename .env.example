# NOVA AI Environment Variables

# App
APP_NAME=NOVA AI
VERSION=0.1
OWNER_NAME=Roshan
DEBUG=True

# AI Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Database (for deployment)
ASTRA_DB_PATH=/var/data/astra.db
MEMORY_FILE_PATH=/var/data/memory.json
LOG_FILE_PATH=/var/data/logs/astra.log

# API URL for frontend (optional - auto-detects local IP)
# VITE_API_URL=http://192.168.1.100:8000

# Google OAuth (for production)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.onrender.com/auth/google/callback

# Session
SESSION_SECRET=your_random_secret_key_here

# Auth
DEV_AUTH=false
